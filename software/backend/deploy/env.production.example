# ==============================================================================
# Production Environment Variables for AWS EC2 & RDS PostgreSQL
# Rename this file to '.env' on your EC2 instance: cp env.production.example .env
# ==============================================================================

# Server Environment Mode
ENVIRONMENT=production

# Database Connection (AWS RDS PostgreSQL)
# Format: postgresql://<DB_USER>:<DB_PASSWORD>@<RDS_ENDPOINT>:5432/<DB_NAME>
DATABASE_URL=postgresql://postgres:YourSecurePassword123@triage-ai-db.c123456.ap-south-1.rds.amazonaws.com:5432/postgres

# Security & JWT Authentication
# Generate a 32+ character random string (e.g. openssl rand -hex 32)
SECRET_KEY=change-this-to-a-secure-random-secret-key-32-chars-long

# Admin Operator Credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=YourAdminSecret2026!
RESET_ADMIN_PASSWORD=false

# Server Bindings
HOST=0.0.0.0
PORT=8000

# Push Notifications (Firebase Service Account)
# Path to your firebase credentials JSON file or paste the raw JSON string
FIREBASE_CREDENTIALS_PATH=firebase_credentials.json

# AWS S3 Storage (for Soldier Photo Uploads)
AWS_ACCESS_KEY_ID=YOUR_AWS_ACCESS_KEY_ID
AWS_SECRET_ACCESS_KEY=YOUR_AWS_SECRET_ACCESS_KEY
AWS_REGION=ap-south-1
S3_BUCKET_NAME=triage-ai-photos

# Alert Critical Thresholds
HR_CRITICAL_THRESHOLD=130
SPO2_CRITICAL_THRESHOLD=90
TEMP_CRITICAL_THRESHOLD=103.0
NO_MOVEMENT_MINUTES=30
