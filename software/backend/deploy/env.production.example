# ==============================================================================
# Production Environment Variables for AWS EC2 & RDS PostgreSQL
# Rename this file to '.env' on your EC2 instance: cp env.production.example .env
# ==============================================================================

# Server Environment Mode
ENVIRONMENT=production

# Database Connection (Supabase PostgreSQL via Transaction Pooler)
# Dashboard → Project Settings → Database → Connection string → Transaction (port 5432)
# Use Transaction pooler so Elastic Beanstalk EC2 instances share connections via pgBouncer.
# IMPORTANT: URL-encode special chars in password (e.g. * -> %2A, @ -> %40)
DATABASE_URL=postgresql://postgres.oggeigcscnywerjjsabc:REPLACE_DB_PASSWORD@aws-0-ap-northeast-1.pooler.supabase.com:5432/postgres

# Supabase project info (used for future Supabase client integrations / Edge Functions)
# Dashboard → Project Settings → API
SUPABASE_URL=https://oggeigcscnywerjjsabc.supabase.co
SUPABASE_KEY=REPLACE_WITH_SUPABASE_ANON_KEY

# Security & JWT Authentication
# Generate a 32+ character random string (e.g. openssl rand -hex 32)
SECRET_KEY=change-this-to-a-secure-random-secret-key-32-chars-long

# Admin Operator Credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=YourAdminSecret2026!
RESET_ADMIN_PASSWORD=false

# Server Bindings
HOST=0.0.0.0
PORT=8000

# Push Notifications (Firebase Service Account)
# Path to your firebase credentials JSON file or paste the raw JSON string
FIREBASE_CREDENTIALS_PATH=firebase_credentials.json

# AWS S3 Storage (for Soldier Photo Uploads)
AWS_ACCESS_KEY_ID=YOUR_AWS_ACCESS_KEY_ID
AWS_SECRET_ACCESS_KEY=YOUR_AWS_SECRET_ACCESS_KEY
AWS_REGION=ap-south-1
S3_BUCKET_NAME=triage-ai-photos

# Alert Critical Thresholds
HR_CRITICAL_THRESHOLD=130
SPO2_CRITICAL_THRESHOLD=90
TEMP_CRITICAL_THRESHOLD=103.0
NO_MOVEMENT_MINUTES=30
